{
  "name": "nvim-init-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:gen": "nvim --headless --cmd \"luafile scripts/generate.lua\"",
    "docs:dev": "npm run docs:gen && vitepress dev",
    "docs:build": "npm run docs:gen && vitepress build",
    "docs:preview": "vitepress preview"
  },
  "devDependencies": {
    "vitepress": "1.6.4"
  }
}
